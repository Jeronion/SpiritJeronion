# Current school.mos.ru cookies: active_student and aupd_token.
# Never send or commit the real values.
MESH_STUDENT_ID=
MESH_TOKEN=

# Optional shared key checked on POST /mesh.
MESH_SERVICE_KEY=

# Use 127.0.0.1 when n8n runs directly on Windows.
# Use 0.0.0.0 when n8n runs in Docker and connects through host.docker.internal.
MESH_HOST=127.0.0.1
MESH_PORT=8787
MESH_TIMEOUT_MS=20000
MESH_CACHE_TTL_MS=120000
